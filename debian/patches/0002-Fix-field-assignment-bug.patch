 interpret.h          | 16 +++++++++++++++-
 pc/Makefile.tst      |  8 +++++++-
 test/Makefile.am     |  6 +++++-
 test/Makefile.in     | 11 ++++++++++-
 test/Maketests       |  5 +++++
 test/fieldassign.awk |  1 +
 test/fieldassign.in  |  2 ++
 test/fieldassign.ok  |  2 ++
 8 files changed, 47 insertions(+), 4 deletions(-)
 create mode 100644 test/fieldassign.awk
 create mode 100644 test/fieldassign.in
 create mode 100644 test/fieldassign.ok

diff --git a/interpret.h b/interpret.h
index 4540d302..f33f3ea8 100644
--- a/interpret.h
+++ b/interpret.h
@@ -872,16 +872,30 @@ mod:
 			break;
 
 		case Op_assign:
+		{
+			NODE *save_lhs;
+
 			lhs = POP_ADDRESS();
 			r = TOP_SCALAR();
-			unref(*lhs);
+			/*
+			 * 1/2023:
+			 * The old NODE pointed to by *lhs has to be freed.
+			 * But we can't free it too early, in case it's both $0 and $1
+			 * (Test case was gawk 'gsub(/./, "@") && $0=$1'). So we save
+			 * the old one, and after the assignment, we free it, since
+			 * $0 and $1 have the same stptr value but only $0 has MALLOC
+			 * in the flags. Whew!
+			 */
+			save_lhs = *lhs;
 			if (r->type == Node_elem_new) {
 				DEREF(r);
 				r = dupnode(Nnull_string);
 			}
 			UPREF(r);
 			UNFIELD(*lhs, r);
+			unref(save_lhs);
 			REPLACE(r);
+		}
 			break;
 
 		case Op_subscript_assign:
